# Copy to .env and fill in the key for the provider you use.

# tokenharbor (default) | gemini | openai | openrouter | groq | ollama
RESUME_TAILOR_PROVIDER=tokenharbor

# Optional. Defaults to deepseek-v4.1-flash:free for tokenharbor,
# gemini-3.8-flash for gemini, gpt-4o-mini for openai.
# Required for openrouter, groq and ollama.
# RESUME_TAILOR_MODEL=deepseek-v4.1-flash:free

# TokenHarbor (OpenAI-compatible, https://tokenharbor.ai/v1)
TOKENHARBOR_API_KEY=
# OPENAI_API_KEY also works as a fallback for tokenharbor.

# Gemini
# GEMINI_API_KEY=

# Optional per-request timeout in seconds (default 30, clamped to 5-300).
# RESUME_TAILOR_TIMEOUT=30

# OpenAI / OpenRouter / Groq / Ollama
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
