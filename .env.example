# Copy to .env and fill in the key for the provider you use.

# gemini (default) | openai | openrouter | groq | ollama
RESUME_TAILOR_PROVIDER=gemini

# Optional. Defaults to gemini-3.8-flash for gemini, gpt-4o-mini for openai.
# Required for openrouter, groq and ollama.
# RESUME_TAILOR_MODEL=gemini-3.8-flash

# Gemini
GEMINI_API_KEY=

# Optional per-request timeout in seconds (default 30, clamped to 5-300).
# RESUME_TAILOR_TIMEOUT=30

# OpenAI / OpenRouter / Groq / Ollama
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
